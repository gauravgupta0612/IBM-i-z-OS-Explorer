        },
        {
          "command": "mf.ibmi.createMember",
          "when": "viewItem == ibmi-srcpf",
          "group": "1_new@1"
        },
        {
          "command": "mf.ibmi.compile",
          "when": "viewItem == ibmi-member",
          "group": "inline@1"
        },
        {
          "command": "mf.ibmi.compile",
          "when": "viewItem == ibmi-member",
          "group": "2_run@1"
        },
        {
          "command": "mf.ibmi.deleteMember",
          "when": "viewItem == ibmi-member",
          "group": "9_del@1"
        },
        {
          "command": "mf.ibmi.createIfsFile",
          "when": "viewItem == ibmi-ifsDir || viewItem == ibmi-ifsPath",
