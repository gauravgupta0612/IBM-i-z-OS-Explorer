          "group": "2_cmd@2"
        },
        {
          "command": "mf.ibmi.terminal",
          "when": "viewItem == profile-ibmi",
          "group": "2_cmd@3"
        },
        {
          "command": "mf.refresh",
          "when": "viewItem =~ /^(zos|ibmi)-(dsRoot|ussRoot|jobRoot|libRoot|ifsRoot|spoolRoot|jobsRoot|dsFilter|jobFilter|ussPath|ds-po|ussDir|lib|srcpf|ifsDir|ifsPath|libFilter|liblRoot|msgqRoot|msgq|favRoot)$/",
          "group": "inline@9"
        },
        {
          "command": "mf.zos.addDsFilter",
          "when": "viewItem == zos-dsRoot",
          "group": "inline@1"
        },
        {
          "command": "mf.zos.createDataset",
          "when": "viewItem == zos-dsRoot || viewItem == zos-dsFilter",
          "group": "1_new@1"
        },
        {
          "command": "mf.zos.addUssPath",
          "when": "viewItem == zos-ussRoot",
          "group": "inline@1"
        },
        {
          "command": "mf.zos.addJobFilter",
          "when": "viewItem == zos-jobRoot",
          "group": "inline@1"
        },
        {
          "command": "mf.removeFilter",
          "when": "viewItem =~ /^(zos-dsFilter|zos-jobFilter|zos-ussPath|ibmi-libFilter|ibmi-ifsPath)$/",
          "group": "inline@8"
        },
        {
          "command": "mf.zos.createMember",
          "when": "viewItem == zos-ds-po",
          "group": "1_new@1"
        },
        {
          "command": "mf.zos.uploadFile",
          "when": "viewItem == zos-ds-po || viewItem == zos-ussDir || viewItem == zos-ussPath",
          "group": "1_new@2"
        },
        {
          "command": "mf.zos.createUssFile",
          "when": "viewItem == zos-ussDir || viewItem == zos-ussPath",
          "group": "1_new@1"
        },
        {
          "command": "mf.zos.createUssDir",
          "when": "viewItem == zos-ussDir || viewItem == zos-ussPath",
          "group": "1_new@2"
        },
        {
          "command": "mf.zos.submitMember",
          "when": "viewItem == zos-member || viewItem == zos-ds-ps",
          "group": "2_run@1"
        },
        {
          "command": "mf.zos.delete",
          "when": "viewItem =~ /^zos-(member|ds-ps|ds-po|ussFile|ussDir)$/",
          "group": "9_del@1"
        },
        {
          "command": "mf.zos.cancelJob",
          "when": "viewItem == zos-job",
          "group": "2_job@1"
        },
        {
          "command": "mf.zos.purgeJob",
          "when": "viewItem == zos-job",
          "group": "2_job@2"
        },
        {
          "command": "mf.zos.downloadAllSpool",
