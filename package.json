    "configuration": {
      "title": "IBM i & z/OS Explorer",
      "properties": {
        "mainframe.zos.maxItems": {
          "type": "number",
          "default": 500,
          "description": "Maximum number of data sets / jobs returned per list request."
        },
        "mainframe.zos.encoding": {
          "type": "string",
          "default": "",
          "description": "Optional EBCDIC code page for data set read/write (e.g. IBM-1047, IBM-037). Empty = z/OSMF default."
        },
        "mainframe.zos.tsoAccount": {
          "type": "string",
          "default": "ACCT#",
          "description": "TSO account number used to start a TSO address space."
        },
        "mainframe.zos.tsoProc": {
          "type": "string",
          "default": "IKJACCNT",
          "description": "TSO logon procedure."
        },
        "mainframe.ibmi.tempDir": {
          "type": "string",
          "default": "/tmp",
          "description": "IFS directory used for temporary files when reading/writing source members."
        },
        "mainframe.ibmi.sourceCcsid": {
          "type": "number",
          "default": 1208,
          "description": "Stream file CCSID used when transferring source members (1208 = UTF-8)."
        },
        "mainframe.ibmi.compileCommands": {
          "type": "object",
          "description": "Compile command per source type. Variables: &LIB, &FILE, &MBR, &OBJLIB.",
          "default": {
            "RPGLE": "CRTBNDRPG PGM(&OBJLIB/&MBR) SRCFILE(&LIB/&FILE) SRCMBR(&MBR) DBGVIEW(*SOURCE) OPTION(*EVENTF)",
            "SQLRPGLE": "CRTSQLRPGI OBJ(&OBJLIB/&MBR) SRCFILE(&LIB/&FILE) SRCMBR(&MBR) OBJTYPE(*PGM) DBGVIEW(*SOURCE) OPTION(*EVENTF)",
            "RPG": "CRTRPGPGM PGM(&OBJLIB/&MBR) SRCFILE(&LIB/&FILE) SRCMBR(&MBR)",
            "CLLE": "CRTBNDCL PGM(&OBJLIB/&MBR) SRCFILE(&LIB/&FILE) SRCMBR(&MBR) DBGVIEW(*SOURCE)",
            "CLP": "CRTCLPGM PGM(&OBJLIB/&MBR) SRCFILE(&LIB/&FILE) SRCMBR(&MBR)",
            "CBLLE": "CRTBNDCBL PGM(&OBJLIB/&MBR) SRCFILE(&LIB/&FILE) SRCMBR(&MBR) DBGVIEW(*SOURCE)",
            "SQLCBLLE": "CRTSQLCBLI OBJ(&OBJLIB/&MBR) SRCFILE(&LIB/&FILE) SRCMBR(&MBR) OBJTYPE(*PGM)",
            "PF": "CRTPF FILE(&OBJLIB/&MBR) SRCFILE(&LIB/&FILE) SRCMBR(&MBR)",
            "LF": "CRTLF FILE(&OBJLIB/&MBR) SRCFILE(&LIB/&FILE) SRCMBR(&MBR)",
            "DSPF": "CRTDSPF FILE(&OBJLIB/&MBR) SRCFILE(&LIB/&FILE) SRCMBR(&MBR)",
            "PRTF": "CRTPRTF FILE(&OBJLIB/&MBR) SRCFILE(&LIB/&FILE) SRCMBR(&MBR)",
            "CMD": "CRTCMD CMD(&OBJLIB/&MBR) PGM(&OBJLIB/&MBR) SRCFILE(&LIB/&FILE) SRCMBR(&MBR)",
            "SQL": "RUNSQLSTM SRCFILE(&LIB/&FILE) SRCMBR(&MBR) COMMIT(*NONE) NAMING(*SQL)",
            "MODULE": "CRTRPGMOD MODULE(&OBJLIB/&MBR) SRCFILE(&LIB/&FILE) SRCMBR(&MBR)"
          }
        },
        "mainframe.zos.jobCard": {
          "type": "string",
          "default": "",
          "description": "Job card used by JCL templates. Variables: ${JOBNAME} ${USER} ${ACCOUNT}. Empty = //${JOBNAME} JOB (${ACCOUNT}),'${USER}',CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),NOTIFY=&SYSUID"
        },
        "mainframe.zos.loadLibrary": {
          "type": "string",
          "default": "",
          "description": "Load library used by JCL templates (${LOADLIB}). Empty = <USER>.LOAD"
        },
        "mainframe.zos.copyLibrary": {
          "type": "string",
          "default": "",
          "description": "Copybook library used by JCL templates (${COPYLIB}). Empty = <USER>.COPYLIB"
        },
        "mainframe.zos.jclTemplates": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": [
              "string",
              "array"
            ]
          },
          "description": "Your own JCL templates: name → JCL text (string or array of lines). Variables: ${JOBCARD} ${JOBNAME} ${USER} ${ACCOUNT} ${MEMBER} ${SRCLIB} ${LOADLIB} ${COPYLIB}. Added to the built-in templates."
        }
      }
    },
    "languages": [
      {
        "id": "jcl",
        "aliases": [
