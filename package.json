    "menus": {
      "view/title": [
        {
          "command": "mf.addZosProfile",
          "when": "view == mf.zosView",
          "group": "navigation@1"
        },
        {
          "command": "mf.refreshAll",
          "when": "view == mf.zosView",
          "group": "navigation@2"
        },
        {
          "command": "mf.addIbmiProfile",
          "when": "view == mf.ibmiView",
          "group": "navigation@1"
        },
        {
          "command": "mf.refreshAll",
          "when": "view == mf.ibmiView",
          "group": "navigation@2"
        },
        {
          "command": "mf.exportConnections",
          "when": "view == mf.zosView || view == mf.ibmiView",
          "group": "9_conn@1"
        },
        {
          "command": "mf.importConnections",
          "when": "view == mf.zosView || view == mf.ibmiView",
          "group": "9_conn@2"
        }
      ],
      "view/item/context": [
        {
          "command": "mf.testConnection",
          "when": "viewItem =~ /^profile/",
          "group": "inline@1"
        },
        {
          "command": "mf.editProfile",
          "when": "viewItem =~ /^profile/",
          "group": "1_profile@1"
        },
        {
          "command": "mf.resetPassword",
          "when": "viewItem =~ /^profile/",
          "group": "1_profile@2"
        },
        {
          "command": "mf.disconnect",
          "when": "viewItem == profile-ibmi",
          "group": "1_profile@3"
        },
        {
          "command": "mf.removeProfile",
          "when": "viewItem =~ /^profile/",
          "group": "9_remove@1"
        },
        {
          "command": "mf.zos.tso",
          "when": "viewItem == profile-zos",
          "group": "2_cmd@1"
