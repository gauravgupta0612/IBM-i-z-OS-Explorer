{
  "name": "ibmi-zos-explorer",
  "displayName": "IBM i & z/OS Explorer",
  "description": "Connect to IBM i (SSH + SQL) and z/OS (z/OSMF REST). Browse libraries, source members, IFS, data sets, USS and jobs; edit and save remote source; submit JCL; run CL, SQL, TSO and console commands; compile members.",
  "version": "1.1.0",
  "publisher": "gauravgupta0612",
  "author": {
    "name": "Gaurav Gupta",
    "url": "https://github.com/gauravgupta0612"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "IBM i",
    "AS400",
    "z/OS",
    "mainframe",
    "zowe",
    "RPG",
    "COBOL",
    "JCL",
    "CL"
  ],
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onFileSystem:mf",
    "onStartupFinished"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gauravgupta0612/IBM-i-z-OS-Explorer.git"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mainframeExplorer",
          "title": "IBM i & z/OS",
          "icon": "media/mainframe.svg"
        }
      ]
    },
    "views": {
      "mainframeExplorer": [
        {
          "id": "mf.zosView",
          "name": "z/OS"
        },
        {
          "id": "mf.ibmiView",
          "name": "IBM i"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mf.zosView",
        "contents": "No z/OS connection yet.\n[Add z/OS Connection](command:mf.addZosProfile)"
      },
      {
        "view": "mf.ibmiView",
        "contents": "No IBM i connection yet.\n[Add IBM i Connection](command:mf.addIbmiProfile)"
      }
    ],
